# ─── Required ────────────────────────────────────────────────
# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # "service_role" secret key — server only, never share

# Generate these on the /setup page of your deployed app (or with: npm run gen-key / npm run hash-password)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD_HASH=                  # format: scrypt.<salt>.<hash>
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=                 # 32 random bytes, base64
CRON_SECRET=

# ─── Safety switch ───────────────────────────────────────────
# Real Instagram publishing happens ONLY when this is exactly "true"
# AND the dashboard switch is on AND Meta permissions are verified.
PUBLISH_LIVE_ENABLED=false

# ─── Optional: AI providers (without them the system runs in test templates/placeholder images) ──
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-1

# ─── Optional: Meta ──────────────────────────────────────────
META_GRAPH_VERSION=v23.0
