# ---------------------------------------------------------------------------
# Terra Nova — environment
# Copy to .env.local (Next.js) / .env (Prisma CLI) and fill in.
#
# Nothing here is required to RUN the app in development: with no DATABASE_URL
# it uses the in-memory repository and with no vision provider it uses the mock
# one. Production is different — the variables marked REQUIRED are checked at
# boot and the process refuses to start without them. See docs/SECURITY.md.
# ---------------------------------------------------------------------------

# REQUIRED IN PRODUCTION. Canonical URLs, sitemap, OpenGraph and the payment
# return URLs are built from it. Must be https:// in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# REQUIRED IN PRODUCTION. Leave empty to run on the in-memory repository, which
# loses everything on restart — development and CI only.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/terranova?schema=public

# REQUIRED IN PRODUCTION. Session signing secret, min 32 characters.
#   openssl rand -base64 32
AUTH_SECRET=

# Overrides NODE_ENV for the production environment check. CI sets this to
# "test" because `next start` always reports production. Never set it on a
# live deployment.
# APP_ENV=

# Seeded admin account (prisma/seed.ts). A production seed refuses to run
# without both, requires a password of at least 12 characters, and does not
# create the demo customer.
SEED_ADMIN_EMAIL=admin@terranova.example
SEED_ADMIN_PASSWORD=

# --- Rate limiting ----------------------------------------------------------
# REQUIRED IN PRODUCTION. Upstash-compatible REST endpoint. Without it the
# limiter is per-process, which behind more than one container limits nothing.
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TOKEN=

# --- Room designer vision provider -----------------------------------------
# mock (default) | remote
ROOM_VISION_PROVIDER=mock
# Credentials for a hosted segmentation model. Never commit real values.
ROOM_VISION_API_URL=
ROOM_VISION_API_KEY=

# --- Object storage ---------------------------------------------------------
# REQUIRED IN PRODUCTION: must be "remote". The local driver writes to
# public/uploads, which on a container platform is ephemeral and per-instance.
STORAGE_DRIVER=local
STORAGE_UPLOAD_URL=
STORAGE_PUBLIC_BASE_URL=
STORAGE_API_KEY=
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- Payments ---------------------------------------------------------------
# manual (default — order recorded, settled offline, never auto-marked PAID)
# hosted | tranzila | cardcom | meshulam — all use the hosted-page adapter.
PAYMENT_PROVIDER=manual
PAYMENT_API_URL=
PAYMENT_TERMINAL_ID=
PAYMENT_API_KEY=
# Shared secret for the callback signature. Required for any hosted gateway:
# without it the webhook refuses every callback, which is the safe default.
PAYMENT_WEBHOOK_SECRET=

# --- Maintenance ------------------------------------------------------------
# Bearer token for POST /api/maintenance/retention. Without it the job refuses
# to run, so it cannot be triggered by accident.
MAINTENANCE_TOKEN=

# --- Observability ----------------------------------------------------------
# debug | info | warn | error. Defaults to info in production.
LOG_LEVEL=
# Any endpoint that accepts a JSON POST receives exceptions.
ERROR_WEBHOOK_URL=

# --- Analytics --------------------------------------------------------------
# console (default) | gtm | plausible
NEXT_PUBLIC_ANALYTICS_DRIVER=console
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
