# ── Database ────────────────────────────────────────────────────────────────
# Any PostgreSQL 14+ with PostGIS. A Supabase project's connection string
# works unchanged; the migrations are Supabase-compatible.
DATABASE_URL=postgresql://getservice:getservice@127.0.0.1:5432/getservice

# ── Session signing ─────────────────────────────────────────────────────────
# REQUIRED in production. Generate with: openssl rand -hex 32
SESSION_SECRET=

# ── Routing / maps (spec §12) ───────────────────────────────────────────────
# MAP_PROVIDER=osrm uses a real routing engine; `estimate` uses a documented
# geometric approximation and marks every ETA it produces as low-confidence.
MAP_PROVIDER=estimate
OSRM_BASE_URL=https://router.project-osrm.org

# ── Payments (spec §27) ─────────────────────────────────────────────────────
# `mock` is a test adapter. It never reports a real charge.
PAYMENT_PROVIDER=mock

# ── Demo mode (spec §59) ────────────────────────────────────────────────────
# Enables the provider simulator and demo-only endpoints. Must be false in
# production; demo rows are tagged is_demo=true and never mix with real data.
DEMO_MODE=true
