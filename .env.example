# ── Database ────────────────────────────────────────────────────────────────
# Any PostgreSQL 14+ with PostGIS. A Supabase project's connection string
# works unchanged; the migrations are Supabase-compatible.
DATABASE_URL=postgresql://getservice_app:getservice_app@127.0.0.1:5432/getservice
DATABASE_ADMIN_URL=postgresql://getservice:getservice@127.0.0.1:5432/getservice

# ── Sessions ────────────────────────────────────────────────────────────────
# There is no signing secret to configure. A session is 32 random bytes from
# the CSPRNG, stored as a SHA-256 hash in `user_sessions` and looked up on
# every request — so there is nothing in the cookie to forge and no key whose
# rotation would be a migration. `SESSION_SECRET` used to be documented here
# as REQUIRED; nothing read it, which is its own kind of security theatre.

# ── Routing / maps (spec §12) ───────────────────────────────────────────────
# MAP_PROVIDER=osrm uses a real routing engine; `estimate` uses a documented
# geometric approximation and marks every ETA it produces as low-confidence.
MAP_PROVIDER=estimate
OSRM_BASE_URL=https://router.project-osrm.org

# ── Payments (spec §27) ─────────────────────────────────────────────────────
# `mock` is a test adapter. It never reports a real charge.
PAYMENT_PROVIDER=mock

# ── Demo mode (spec §59) ────────────────────────────────────────────────────
# Enables the provider simulator and demo-only endpoints. Must be false in
# production; demo rows are tagged is_demo=true and never mix with real data.
DEMO_MODE=true
