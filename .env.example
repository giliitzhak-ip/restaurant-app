# ─────────────────────────────────────────────────────────────────────────────
# GET SERVICE — environment variables
# Copy to `.env.local` and fill in. NEVER commit real secrets.
# Every integration has a mock/dev fallback, so the app boots without any key.
# ─────────────────────────────────────────────────────────────────────────────

# --- Supabase (required for real data; without it the app runs in DEMO mode) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Maps -------------------------------------------------------------------
# provider: google | mapbox | mock
NEXT_PUBLIC_MAPS_PROVIDER=mock
MAPS_API_KEY=your-maps-server-key
NEXT_PUBLIC_MAPS_API_KEY=your-maps-browser-key

# --- Payments ---------------------------------------------------------------
# provider: stripe | israeli | mock
PAYMENT_PROVIDER=mock
PAYMENT_SECRET_KEY=sk_test_your_key
PAYMENT_WEBHOOK_SECRET=whsec_your_secret
NEXT_PUBLIC_PAYMENT_PUBLIC_KEY=pk_test_your_key

# --- Notifications ----------------------------------------------------------
# channel adapters: console | live  (console = logs only, safe for dev)
NOTIFICATIONS_MODE=console
SMS_API_KEY=your-sms-key
SMS_SENDER_ID=GETSERVICE
EMAIL_API_KEY=your-email-key
EMAIL_FROM=no-reply@getservice.example
PUSH_API_KEY=your-push-key
WHATSAPP_API_KEY=your-whatsapp-key
WHATSAPP_PHONE_ID=your-whatsapp-phone-id

# --- AI job classification (optional, mock by default) ----------------------
AI_CLASSIFIER_PROVIDER=mock
AI_CLASSIFIER_API_KEY=your-llm-key

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=he
