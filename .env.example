# יומן הדברה – יצחק הדברות · דוגמה למשתני סביבה
#
# הקובץ הזה הוא דוגמה בלבד ואינו מכיל סודות.
# להרצה מקומית: cp .env.example .env ואז למלא ערכים.
# אין להוסיף לכאן סיסמאות, אסימונים או מפתחות – .env עצמו אינו נשמר בגיט.

# ───────── שרת ─────────

# הפורט שעליו השרת מאזין. ברירת מחדל: 3000
PORT=3000

# תיקיית הנתונים: שם נשמר קובץ ה-SQLite והגיבויים שלפני מיגרציות.
# מחוץ לתיקיית הפרויקט בסביבת ייצור, כדי שפריסה לא תמחק נתונים.
DATA_DIR=./data

# ───────── בנייה של צד הלקוח ─────────

# 1 = בנייה ללא שרת (הדגמה או אירוח סטטי): אין סנכרון ואין התחברות.
# הנתונים נשמרים במכשיר בלבד. להשארה ריק באפליקציה אמיתית.
VITE_STANDALONE=

# כתובת מלאה של השרת, לדוגמה https://api.example.co.il
# נדרש באפליקציה מקומפלת (Capacitor), שבה נתיב יחסי לא מגיע לשרת.
# כשהאפליקציה מוגשת מאותו שרת (PWA) אפשר להשאיר ריק.
VITE_API_BASE=

# ───────── מה אין כאן, ולמה ─────────
#
# אין מפתחות API בצד הלקוח. כל מה שנכנס ל-VITE_* נארז לתוך ה-bundle
# ונחשף לכל מי שפותח את האפליקציה; סוד שנדרש – מקומו בשרת בלבד.
#
# סיסמת מנהל המערכת אינה משתנה סביבה. היא נקבעת בהרצה:
#   npm run create-admin -- admin@example.co.il 'סיסמה' 'שם'
# והיא נשמרת כגיבוב scrypt עם salt, ולא בקובץ.
