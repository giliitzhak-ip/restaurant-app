# ---------------------------------------------------------------------------
# Terra Nova — environment
# Copy to .env.local (Next.js) / .env (Prisma CLI) and fill in.
# Nothing here is required to RUN the app: with no DATABASE_URL it uses the
# in-memory repository, and with no vision provider it uses the mock provider.
# ---------------------------------------------------------------------------

# Public site URL — used for canonical URLs, sitemap and OpenGraph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL. Leave empty to run on the in-memory repository.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/terranova?schema=public

# Session signing secret (min 32 chars). Generate with: openssl rand -base64 32
AUTH_SECRET=

# Seeded admin account (prisma/seed.ts)
SEED_ADMIN_EMAIL=admin@terranova.example
SEED_ADMIN_PASSWORD=

# --- Room designer vision provider -----------------------------------------
# mock (default) | replicate | custom
ROOM_VISION_PROVIDER=mock
# Credentials for a hosted segmentation model. Never commit real values.
ROOM_VISION_API_URL=
ROOM_VISION_API_KEY=

# --- Object storage ---------------------------------------------------------
# local (default, writes to public/uploads) | s3
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# --- Payments ---------------------------------------------------------------
# manual (default — order recorded, paid offline) | tranzila | cardcom | stripe
PAYMENT_PROVIDER=manual
PAYMENT_TERMINAL_ID=
PAYMENT_API_KEY=

# --- Analytics --------------------------------------------------------------
# console (default) | gtm | plausible
NEXT_PUBLIC_ANALYTICS_DRIVER=console
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
