{
  "name": "get-service",
  "version": "0.1.0",
  "private": true,
  "description": "GET SERVICE — real-time marketplace for professional services",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "db:roles": "node scripts/setup-roles.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:reset": "node scripts/migrate.mjs --reset",
    "db:seed": "node scripts/seed.mjs",
    "db:setup": "node scripts/setup-roles.mjs && node scripts/migrate.mjs --reset && node scripts/seed.mjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "1.47.0",
    "next": "16.3.5",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
