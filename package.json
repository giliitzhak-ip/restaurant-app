{
  "name": "terra-nova-surfaces",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "assets:check": "node scripts/check-asset-budget.mjs",
    "audit:security": "npm audit --audit-level=high",
    "build": "next build",
    "compliance:check": "tsx scripts/compliance-check.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "dev": "next dev",
    "lint": "eslint .",
    "media:ensure": "tsx scripts/generate-media.ts && tsx scripts/generate-objects.ts",
    "media:generate": "tsx scripts/generate-media.ts --force",
    "objects:ensure": "tsx scripts/generate-objects.ts",
    "objects:generate": "tsx scripts/generate-objects.ts --force",
    "postinstall": "prisma generate",
    "prebuild": "prisma generate",
    "predev": "tsx scripts/generate-media.ts && tsx scripts/generate-objects.ts",
    "qa": "npm run lint && npm run typecheck && npm run test:unit && npm run compliance:check && npm run build",
    "qa:flows": "node scripts/qa-flows.mjs",
    "qa:responsive": "node scripts/qa-responsive.mjs",
    "start": "next start",
    "test": "playwright test",
    "test:a11y": "playwright test tests/a11y",
    "test:compliance": "playwright test tests/compliance.spec.ts",
    "test:e2e": "playwright test",
    "test:security": "playwright test tests/security",
    "test:unit": "node --import tsx --test \"tests/unit/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.1.0",
    "lucide-react": "^0.548.0",
    "next": "16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.65.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.5",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "mysql2": "^3.24.4",
    "deepmerge-ts": "^8.0.2"
  }
}
