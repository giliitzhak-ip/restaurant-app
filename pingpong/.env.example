# ---------- Server (Node.js) ----------
# Port the HTTP + WebSocket server listens on (most hosts inject PORT automatically).
PORT=8080
# Interface to bind. 0.0.0.0 is required inside containers / on PaaS hosts.
HOST=0.0.0.0
# Comma-separated list of allowed browser origins for WebSocket connections.
# Leave empty to allow any origin (fine for same-origin deployments).
# Example: ALLOWED_ORIGINS=https://pingpong.example.com,https://www.pingpong.example.com
ALLOWED_ORIGINS=
# Optional: terminate TLS in Node itself (only if you are NOT behind an HTTPS proxy / PaaS).
# Paths to PEM files. When both are set the server speaks HTTPS + WSS directly.
TLS_CERT_FILE=
TLS_KEY_FILE=
# Set to 1 when running behind a reverse proxy so X-Forwarded-For is used for per-IP limits.
TRUST_PROXY=1
# Maximum simultaneous rooms.
MAX_ROOMS=500

# ---------- Client (Vite, build time) ----------
# WebSocket endpoint the browser connects to. Leave empty when the server also
# serves the client (same origin) - the client then uses wss://<current host>/ws.
# Set it when the client is hosted separately (e.g. static hosting):
# VITE_SERVER_URL=wss://pingpong-server.example.com/ws
VITE_SERVER_URL=
