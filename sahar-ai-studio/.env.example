# ─────────────────────────────────────────────────────────────────────────────
# SAHAR AI STUDIO — environment configuration
# Copy to `.env` (never commit `.env`). All secrets are read server-side only;
# nothing here is exposed to the browser (no NEXT_PUBLIC_* secrets).
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=info

# Public base URL of the web app (used for absolute links and webhook callbacks).
APP_URL=http://localhost:3000

# ── Database (PostgreSQL 16) ────────────────────────────────────────────────
# Matches the `postgres` service in docker-compose.yml.
DATABASE_URL=postgresql://sahar:sahar_dev_password@localhost:5432/sahar?schema=public
# Used by integration tests (database is reset by the test setup).
TEST_DATABASE_URL=postgresql://sahar:sahar_dev_password@localhost:5432/sahar_test?schema=public

# ── Redis 7 (BullMQ queues, rate limiting) ──────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Authentication ──────────────────────────────────────────────────────────
# At least 32 random characters. Generate with: openssl rand -base64 48
# Used to derive keys for signed values (e.g. future media URL signing).
AUTH_SECRET=replace-with-at-least-32-random-characters
# Session lifetime in days (sliding).
SESSION_TTL_DAYS=30
# Set to false to disable public sign-up (private deployments).
ALLOW_REGISTRATION=true
# Brute-force protection (login: per 15 minutes, registration: per hour).
AUTH_LOGIN_MAX_PER_IP=30
AUTH_LOGIN_MAX_PER_EMAIL=8
AUTH_REGISTER_MAX_PER_IP=5

# ── Object storage (S3-compatible; SeaweedFS in development) ────────────────
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=sahar-media
S3_ACCESS_KEY_ID=sahar
S3_SECRET_ACCESS_KEY=sahar_dev_storage_password
# Self-hosted S3 servers need path-style addressing; AWS S3 does not.
S3_FORCE_PATH_STYLE=true
# Lifetime of presigned upload/download URLs, in seconds.
S3_SIGNED_URL_TTL_SECONDS=900

# ── Upload limits ───────────────────────────────────────────────────────────
MAX_AUDIO_UPLOAD_MB=100
MAX_IMAGE_UPLOAD_MB=15

# ── Media tools (worker) ────────────────────────────────────────────────────
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ── AI providers (leave empty until you have an account and approve usage) ──
# No paid generation is ever started without explicit approval in the UI.
# Hedra — https://www.hedra.com (Phase 4)
HEDRA_API_KEY=
# fal.ai — https://fal.ai (Phase 6)
FAL_KEY=
# Local GPU inference server (Phase 7, not operational yet)
LOCAL_GPU_BASE_URL=
