// Terra Nova — surfaces storefront
// PostgreSQL + Prisma. Run `npm run db:push && npm run db:seed` after setting
// DATABASE_URL. Without DATABASE_URL the app falls back to the in-memory
// repository (see src/server/repositories/README.md), so local development and
// CI work with no database at all.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/**
 * ----------------------------- enums -----------------------------
 */

enum Role {
  CUSTOMER
  ADMIN
}

enum SurfaceTarget {
  FLOOR
  WALL
  BOTH
}

enum WaterResistance {
  WATERPROOF
  SPLASH_PROOF
  NOT_RESISTANT
}

enum UsageArea {
  INDOOR
  OUTDOOR
  BOTH
}

enum Tone {
  LIGHT
  NATURAL
  WARM
  COLD
  DARK
}

enum MaterialFamily {
  WOOD
  SPC
  LAMINATE
  MDF
  STONE
  CONCRETE
  PVC
  METAL
}

enum StyleTag {
  MODERN
  MINIMAL
  LUXURY
  WARM
  SCANDINAVIAN
  INDUSTRIAL
  CLASSIC
}

enum PatternType {
  PLANK
  TILE
  PANEL
  STONE
  CUSTOM
}

enum TextureOrientation {
  HORIZONTAL
  VERTICAL
  DIAGONAL
}

enum PricingUnit {
  PACKAGE
  ITEM
}

enum ImageKind {
  STUDIO
  ROOM
  DETAIL
}

enum FulfilmentMethod {
  SHIPPING
  PICKUP
}

/// Purchase lifecycle. The CART stage lives in the Cart model — an Order row
/// is only written once checkout starts, so the first state a row can hold is
/// PAYMENT_PENDING (hosted gateway) or PENDING (offline settlement).
enum OrderStatus {
  PAYMENT_PENDING
  PENDING
  PAID
  PAYMENT_FAILED
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

/// Every step of a payment, so a dispute can be reconstructed without ever
/// having stored a card number.
enum PaymentEventKind {
  INTENT_CREATED
  REDIRECTED
  WEBHOOK_RECEIVED
  AUTHORISED
  FAILED
  CANCELLED
  REFUNDED
}

enum QuoteStatus {
  NEW
  IN_PROGRESS
  SENT
  WON
  LOST
}

enum CouponKind {
  PERCENT
  FIXED
}

enum SurfaceKind {
  FLOOR
  WALL
  CEILING
}

/**
 * ----------------------------- people ----------------------------
 */

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  phone        String?
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses Address[]
  carts     Cart[]
  orders    Order[]
  quotes    Quote[]
  designs   RoomDesign[]
  favorites Favorite[]
  reviews   Review[]

  @@index([role])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  fullName  String
  phone     String
  street    String
  city      String
  zip       String?
  floor     String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/**
 * ---------------------------- catalogue --------------------------
 */

model Category {
  id               String        @id @default(cuid())
  slug             String        @unique
  name             String
  shortDescription String
  longDescription  String
  heroImage        String
  tileImage        String
  surface          SurfaceTarget @default(BOTH)
  position         Int           @default(0)
  seoTitle         String
  seoDescription   String
  active           Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  products Product[]
}

model Collection {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  story       String
  heroImage   String
  featured    Boolean  @default(false)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

model Product {
  id                String @id @default(cuid())
  slug              String @unique
  sku               String @unique
  name              String
  subtitle          String
  brand             String
  description       String
  installationNotes String
  maintenanceNotes  String

  categoryId   String
  collectionId String?

  pricePerUnit       Float
  compareAtPrice     Float?
  pricingUnit        PricingUnit @default(PACKAGE)
  packageCoverageSqm Float?
  pricePerSqm        Float?

  stockUnits      Int     @default(0)
  lowStockAt      Int     @default(20)
  leadTimeDays    Int     @default(5)
  sampleAvailable Boolean @default(true)
  quoteOnly       Boolean @default(false)

  // --- specification
  material          MaterialFamily
  materialLabel     String
  widthMm           Int
  lengthMm          Int
  thicknessMm       Float
  wearLayerMm       Float?
  colorName         String
  colorHex          String
  tone              Tone
  style             StyleTag[]
  textureLabel      String
  durability        String
  warrantyYears     Int
  installationType  String
  waterResistance   WaterResistance
  usage             UsageArea
  surface           SurfaceTarget
  underfloorHeating Boolean         @default(false)
  acousticRating    String?

  featured      Boolean @default(false)
  isNew         Boolean @default(false)
  bestSeller    Boolean @default(false)
  active        Boolean @default(true)
  popularity    Int     @default(0)
  ratingAverage Float   @default(0)
  ratingCount   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category           Category            @relation(fields: [categoryId], references: [id])
  collection         Collection?         @relation(fields: [collectionId], references: [id])
  images             ProductImage[]
  texture            ProductTexture?
  cartItems          CartItem[]
  orderItems         OrderItem[]
  favorites          Favorite[]
  reviews            Review[]
  quotes             Quote[]
  surfaces           RoomSurface[]
  designObjectAssets DesignObjectAsset[]

  @@index([categoryId])
  @@index([collectionId])
  @@index([active, featured])
  @@index([pricePerSqm])
}

model ProductImage {
  id        String    @id @default(cuid())
  productId String
  url       String
  alt       String
  kind      ImageKind @default(STUDIO)
  position  Int       @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

/// The texture the room designer tiles into a customer photo.
/// widthCm/heightCm are the real-world footprint of the whole image;
/// repeatX/repeatY say how many product units are visible inside it.
model ProductTexture {
  id           String             @id @default(cuid())
  productId    String             @unique
  imageUrl     String
  thumbnailUrl String
  widthCm      Float
  heightCm     Float
  patternType  PatternType
  repeatX      Int                @default(1)
  repeatY      Int                @default(1)
  orientation  TextureOrientation @default(HORIZONTAL)
  scaleFactor  Float              @default(1)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Review {
  id         String   @id @default(cuid())
  productId  String?
  userId     String?
  authorName String
  city       String
  rating     Int
  title      String
  body       String
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, approved])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

/**
 * ------------------------------ cart -----------------------------
 */

model Cart {
  id              String           @id @default(cuid())
  userId          String?
  couponCode      String?
  installation    Boolean          @default(false)
  installationSqm Float            @default(0)
  fulfilment      FulfilmentMethod @default(SHIPPING)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  items CartItem[]

  @@index([userId])
}

model CartItem {
  id           String   @id @default(cuid())
  cartId       String
  productId    String
  units        Int
  requestedSqm Float?
  sample       Boolean  @default(false)
  designId     String?
  designLabel  String?
  createdAt    DateTime @default(now())

  cart    Cart        @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product     @relation(fields: [productId], references: [id])
  design  RoomDesign? @relation(fields: [designId], references: [id], onDelete: SetNull)

  @@index([cartId])
}

/**
 * ----------------------------- orders ----------------------------
 */

model Order {
  id                String           @id @default(cuid())
  number            String           @unique
  /// Unguessable secret in the confirmation URL. The order number is
  /// sequential and therefore public; this is what actually authorises a
  /// guest to read their own order.
  publicToken       String           @unique
  userId            String?
  status            OrderStatus      @default(PAYMENT_PENDING)
  customerName      String
  phone             String
  email             String
  fulfilment        FulfilmentMethod
  street            String?
  city              String?
  zip               String?
  floor             String?
  notes             String?
  installation      Boolean          @default(false)
  subtotal          Float
  discount          Float            @default(0)
  shipping          Float            @default(0)
  installationTotal Float            @default(0)
  total             Float
  couponCode        String?
  /// Rate snapshot: a VAT change must not rewrite historical invoices.
  vatRate           Float            @default(0.18)
  currency          String           @default("ILS")
  paymentProvider   String           @default("manual")
  paymentReference  String?
  /// Deduplicates a double-submitted checkout into one order.
  idempotencyKey    String?          @unique
  /// True once stock has been decremented for this order.
  stockCommitted    Boolean          @default(false)
  paidAt            DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user         User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  transactions PaymentTransaction[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

/// Append-only payment log. `detail` is written through a scrubber that drops
/// anything resembling a PAN, CVV or cardholder name, so PCI scope never
/// reaches this table.
model PaymentTransaction {
  id        String           @id @default(cuid())
  orderId   String
  provider  String
  kind      PaymentEventKind
  status    String
  amount    Float
  currency  String           @default("ILS")
  reference String?
  /// Provider-supplied event id; the unique index makes webhook replay a no-op.
  eventId   String?          @unique
  detail    Json?
  createdAt DateTime         @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([provider, reference])
}

/// Gapless counters. Order numbers come from here rather than from a random
/// draw, so two concurrent checkouts cannot collide.
model Sequence {
  name  String @id
  value Int    @default(0)
}

/// Who changed what in the admin panel.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String
  entity     String
  entityId   String?
  detail     Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  productId  String
  name       String
  imageUrl   String
  units      Int
  unitPrice  Float
  coveredSqm Float?
  lineTotal  Float
  designId   String?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

/**
 * ----------------------------- quotes ----------------------------
 */

model Quote {
  id                String      @id @default(cuid())
  number            String      @unique
  userId            String?
  status            QuoteStatus @default(NEW)
  customerName      String
  phone             String
  email             String?
  city              String
  areaSqm           Float?
  productId         String?
  designId          String?
  imageUrl          String?
  wantsInstallation Boolean     @default(false)
  notes             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user    User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  product Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  design  RoomDesign? @relation(fields: [designId], references: [id], onDelete: SetNull)

  @@index([status])
}

/**
 * -------------------------- room designs -------------------------
 */

model RoomDesign {
  id               String    @id @default(cuid())
  userId           String?
  /// Set for guest designs so they can be claimed after sign-up.
  guestToken       String?
  name             String
  originalImageUrl String
  renderedImageUrl String?
  estimatedAreaSqm Float     @default(0)
  estimatedPrice   Float     @default(0)
  /// Raw provider output (masks, detected objects, quality metrics).
  analysis         Json?
  /// Objects, lighting fixtures, LED paths, layer state and viewport.
  ///
  /// One document rather than a table per array: these are edited together,
  /// read together and never queried independently, and a design is only ever
  /// meaningful as a whole. `sceneVersion` is the schema version the document
  /// was written with, so a reader can migrate an older one instead of
  /// guessing.
  scene            Json?
  sceneVersion     Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  /// Privacy by design: the retention job deletes images past this date.
  expiresAt        DateTime?

  user      User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  surfaces  RoomSurface[]
  versions  RoomDesignVersion[]
  cartItems CartItem[]
  quotes    Quote[]

  @@index([userId])
  @@index([guestToken])
  @@index([expiresAt])
}

model RoomSurface {
  id        String      @id @default(cuid())
  designId  String
  kind      SurfaceKind
  label     String
  productId String?
  /// Normalised polygon + holes, so a mask stays valid at any resolution.
  mask      Json
  /// Orientation, scale, brightness, offsets, lighting strength.
  settings  Json
  areaSqm   Float       @default(0)

  design  RoomDesign @relation(fields: [designId], references: [id], onDelete: Cascade)
  product Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([designId])
}

/**
 * ---------------------------- marketing --------------------------
 */

model Coupon {
  id          String     @id @default(cuid())
  code        String     @unique
  kind        CouponKind
  value       Float
  minSubtotal Float?
  active      Boolean    @default(true)
  expiresAt   DateTime?
  usageCount  Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model NewsletterSignup {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

/// A kept version of a design.
///
/// Separate from the design itself so "keep this one and try something else"
/// does not mean duplicating the whole row, and so a customer can go back to
/// a layout after an hour of changes that Undo no longer reaches.
model RoomDesignVersion {
  id         String   @id @default(cuid())
  designId   String
  label      String?
  /// Full snapshot: surfaces and scene as they were when it was kept.
  snapshot   Json
  previewUrl String?
  createdAt  DateTime @default(now())

  design RoomDesign @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@index([designId, createdAt])
}

/// How the object library is grouped in the "add items" drawer.
///
/// The twenty seeded keys are the ones behaviour keys off; a category added
/// here is a grouping label, because how a thing snaps is a property of its
/// assets rather than of its name.
model DesignObjectCategory {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  sortOrder Int      @default(0)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assets DesignObjectAsset[]

  @@index([sortOrder])
}

/// One item in the object library.
///
/// There is deliberately no price column. A price typed onto a library asset
/// is a price with nothing behind it, and would be wrong the first time the
/// catalogue changed. An asset that is for sale carries `productId`, and the
/// price, stock and name come from that product; everything else is drawn so
/// the room can be pictured and is labelled for illustration only.
model DesignObjectAsset {
  id           String          @id @default(cuid())
  categoryId   String
  name         String
  /// Transparent PNG or SVG. Never an image with a baked-in background.
  assetUrl     String
  /// Real-world size, which is what makes a 65" television look like one.
  realWidthCm  Float
  realHeightCm Float
  snap         SceneSnapTarget @default(WALL)
  soldOnSite   Boolean         @default(false)
  productId    String?
  sortOrder    Int             @default(0)
  enabled      Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  category DesignObjectCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product  Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([categoryId, sortOrder])
  @@index([productId])
}

/// A named lighting arrangement the admin can offer as a starting point.
model LightingPreset {
  id         String   @id @default(cuid())
  name       String
  sortOrder  Int      @default(0)
  enabled    Boolean  @default(true)
  /// Fixtures and LED runs the preset drops in, without ids or positions.
  definition Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([sortOrder])
}

enum SceneSnapTarget {
  WALL
  FLOOR
  NICHE
  FREE
}
