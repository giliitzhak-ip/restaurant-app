# ─────────────────────────────────────────────────────────────
# SAHAR FACE MOTION AI — environment variables
# Copy to .env and fill in. All secrets are read on the server only;
# none of these are exposed to the browser (no NEXT_PUBLIC_ prefix).
# ─────────────────────────────────────────────────────────────

# App
APP_URL=http://localhost:3000
NODE_ENV=development
# 32+ random chars, used to sign upload/download URLs (openssl rand -hex 32)
APP_SECRET=change-me-to-a-long-random-string

# PostgreSQL
DATABASE_URL=postgresql://sahar:sahar@localhost:5432/sahar?schema=public

# Redis (BullMQ job queue + rate limiting)
REDIS_URL=redis://localhost:6379

# S3-compatible storage (MinIO locally, AWS S3 / Cloudflare R2 in production)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=sahar-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Upload limits
MAX_IMAGE_MB=15
MAX_VIDEO_MB=500
MAX_AUDIO_MB=50
MAX_VIDEO_SECONDS=180

# FFmpeg (leave empty to use binaries on PATH)
FFMPEG_PATH=
FFPROBE_PATH=

# ── AI providers ─────────────────────────────────────────────
# Each module picks a provider. "mock" = local test provider that never
# calls a paid service and clearly labels its output as a test.
# A real provider is only used when its key is set AND it is selected here.
FACE_SWAP_PROVIDER=mock
MOTION_PROVIDER=mock
VOICE_PROVIDER=mock
LIPSYNC_PROVIDER=mock

# Paid calls are blocked unless this is explicitly "true".
ALLOW_PAID_PROVIDERS=false

# ElevenLabs (voice: TTS / cloning / speech-to-speech)
ELEVENLABS_API_KEY=
# Resemble AI (alternative voice provider)
RESEMBLE_API_KEY=
# Sync Labs / sync.so (lip sync)
SYNC_API_KEY=
# Akool (hosted video face swap)
AKOOL_API_KEY=
# fal.ai (hosted face swap / motion transfer / lip sync models)
FAL_KEY=
# Replicate (hosted models)
REPLICATE_API_TOKEN=
# Runway (motion transfer / character performance)
RUNWAYML_API_SECRET=
# Self-hosted GPU worker (FaceFusion etc.) — future
GPU_WORKER_URL=
GPU_WORKER_TOKEN=
