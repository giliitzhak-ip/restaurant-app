# ─────────────────────────────────────────────────────────────
# SAHAR FACE MOTION AI — environment variables
# Copy to .env and fill in. All secrets are read on the server only;
# none of these are exposed to the browser (no NEXT_PUBLIC_ prefix).
# ─────────────────────────────────────────────────────────────

# App
APP_URL=http://localhost:3000
NODE_ENV=development
# 32+ random chars, used to sign upload/download URLs (openssl rand -hex 32)
APP_SECRET=change-me-to-a-long-random-string

# PostgreSQL
DATABASE_URL=postgresql://sahar:sahar@localhost:5432/sahar?schema=public

# Redis (BullMQ job queue + rate limiting)
REDIS_URL=redis://localhost:6379

# File storage: "s3" (MinIO locally, AWS S3 / Cloudflare R2 in production)
# or "local" (files on this server's disk under STORAGE_DIR; single-machine only)
STORAGE_DRIVER=s3
STORAGE_DIR=./storage
# S3-compatible storage settings (used when STORAGE_DRIVER=s3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=sahar-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# Create the bucket automatically if missing (handy for local MinIO; keep false for managed buckets)
S3_CREATE_BUCKET=true

# Upload limits
MAX_IMAGE_MB=15
MAX_VIDEO_MB=500
MAX_AUDIO_MB=50
MAX_VIDEO_SECONDS=180
MAX_AUDIO_SECONDS=600
# Total storage per user
MAX_STORAGE_MB_PER_USER=5120
# Parallel FFmpeg jobs per worker process
MEDIA_WORKER_CONCURRENCY=2

# FFmpeg (leave empty to use binaries on PATH)
FFMPEG_PATH=
FFPROBE_PATH=

# ── AI providers ─────────────────────────────────────────────
# Each module picks a provider. "mock" = local test provider that never
# calls a paid service and clearly labels its output as a test.
# A real provider is only used when its key is set AND it is selected here.
FACE_SWAP_PROVIDER=mock
MOTION_PROVIDER=mock
VOICE_PROVIDER=mock
LIPSYNC_PROVIDER=mock

# Paid calls are blocked unless this is explicitly "true".
ALLOW_PAID_PROVIDERS=false
# Hard ceiling for a single job, and the highest monthly budget a user may set (USD).
MAX_JOB_COST_USD=20
MAX_USER_MONTHLY_BUDGET_USD=50
# AI worker
AI_WORKER_CONCURRENCY=3
AI_JOB_TIMEOUT_MIN=60

# Face swap: FACE_SWAP_PROVIDER = mock | magichour | gpu-worker
# Magic Hour (recommended cloud provider). Get a key at https://magichour.ai/developer
MAGIC_HOUR_API_KEY=
# Price of one credit on YOUR plan (USD). Used for the estimate shown before approval.
MAGIC_HOUR_USD_PER_CREDIT=0.0025
MAGIC_HOUR_CREDITS_PER_FRAME=1
MAGIC_HOUR_MAX_SECONDS=180
# default | v1 | v2
MAGIC_HOUR_STYLE_VERSION=default

# Local face detection (YuNet + SFace via OpenCV). See README → "Face detection".
PYTHON_BIN=
FACE_MODELS_DIR=ai/models

# ElevenLabs (voice: TTS / cloning / speech-to-speech)
ELEVENLABS_API_KEY=
# Resemble AI (alternative voice provider)
RESEMBLE_API_KEY=
# Sync Labs / sync.so (lip sync)
SYNC_API_KEY=
# Akool Face Swap Plus (alternative; adapter not built yet)
AKOOL_API_KEY=
# fal.ai (hosted face swap / motion transfer / lip sync models)
FAL_KEY=
# Replicate (hosted models)
REPLICATE_API_TOKEN=
# Runway (motion transfer / character performance)
RUNWAYML_API_SECRET=
# Self-hosted GPU worker (FaceFusion etc.) — future; contract in ARCHITECTURE.md §6
GPU_WORKER_MAX_SECONDS=180
GPU_WORKER_URL=
GPU_WORKER_TOKEN=
