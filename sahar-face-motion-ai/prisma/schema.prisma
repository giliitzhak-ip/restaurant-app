// SAHAR FACE MOTION AI — database schema.
// The full domain model is defined up front so later phases only add columns,
// not restructure tables. See DATABASE_SCHEMA.md for the rationale.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum AssetKind {
  IMAGE
  VIDEO
  AUDIO
}

enum AssetRole {
  SOURCE // uploaded by the user
  GENERATED // produced by an AI provider (always AI-labelled)
  EXPORT // produced by the video editor / FFmpeg
}

enum ConsentSubject {
  FACE
  VOICE
  VIDEO
}

enum ConsentRelationship {
  SELF // the user is the person in the media
  OTHER_WITH_PERMISSION // the user holds explicit permission from the person
  OWNED_CONTENT // footage/material the user owns rights to (no identifiable person rights claimed)
}

enum VoiceKind {
  PRESET // provider library voice
  DESIGNED // original synthetic voice (e.g. comic / parody style)
  CLONED // clone of a consenting real person
}

enum JobType {
  MEDIA_PROBE
  FACE_DETECT
  FACE_SWAP
  MOTION_TRANSFER
  TTS
  VOICE_CLONE
  SPEECH_TO_SPEECH
  LIP_SYNC
  VIDEO_EXPORT
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String
  passwordHash      String
  role              UserRole  @default(USER)
  termsAcceptedAt   DateTime
  // Cost & usage guards (enforced by the job API from phase 3 on).
  monthlyBudgetCents Int      @default(0) // 0 = paid providers disabled for this user
  dailyJobLimit     Int       @default(20)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sessions Session[]
  projects Project[]
  assets   Asset[]
  consents ConsentRecord[]
  voices   Voice[]
  jobs     Job[]
  events   ProjectEvent[]
  usage    UsageRecord[]
}

model Session {
  id         String   @id @default(cuid())
  // SHA-256 of the random session token; the raw token only lives in the cookie.
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  userAgent  String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([userId])
}

model Project {
  id          String    @id @default(cuid())
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  aspectRatio String    @default("9:16") // "9:16" | "16:9" | "1:1"
  // Set when the project is duplicated, for history.
  duplicatedFromId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  assets Asset[]
  jobs   Job[]
  events ProjectEvent[]

  @@index([ownerId, createdAt])
}

model Asset {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ownerId      String
  owner        User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  kind         AssetKind
  role         AssetRole
  // Object key in S3-compatible storage. Never a public URL; served via signed URLs.
  storageKey   String    @unique
  mimeType     String
  sizeBytes    BigInt
  originalName String?
  checksumSha256 String?
  // Media metadata from FFprobe.
  width        Int?
  height       Int?
  durationMs   Int?
  fps          Float?
  hasAudio     Boolean?
  // AI disclosure: true for anything a model produced or modified.
  aiGenerated  Boolean   @default(false)
  consentId    String?
  consent      ConsentRecord? @relation(fields: [consentId], references: [id], onDelete: SetNull)
  producedByJobId String?
  producedByJob   Job?    @relation("JobOutputs", fields: [producedByJobId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())

  @@index([projectId])
  @@index([ownerId])
}

model ConsentRecord {
  id           String              @id @default(cuid())
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject      ConsentSubject
  relationship ConsentRelationship
  subjectName  String              // name of the person whose face/voice is used
  statement    String              // exact declaration text the user agreed to (Hebrew)
  statementVersion String
  // Provider-side verification (e.g. voice-verification captcha) when available.
  verifiedAt   DateTime?
  verificationMethod String?
  revokedAt    DateTime?
  ip           String?
  userAgent    String?
  createdAt    DateTime            @default(now())

  assets Asset[]
  voices Voice[]

  @@index([userId])
}

model Voice {
  id              String     @id @default(cuid())
  ownerId         String
  owner           User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name            String
  kind            VoiceKind
  provider        String     // e.g. "elevenlabs", "mock"
  providerVoiceId String
  gender          String?    // "male" | "female" | "neutral"
  language        String     @default("he")
  styleNotes      String?
  consentId       String?
  consent         ConsentRecord? @relation(fields: [consentId], references: [id], onDelete: Cascade)
  createdAt       DateTime   @default(now())

  @@index([ownerId])
}

model Job {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          JobType
  status        JobStatus @default(QUEUED)
  progress      Int       @default(0) // 0..100, written by the worker
  provider      String
  providerJobId String?
  input         Json
  output        Json?
  errorCode     String?
  errorMessage  String?   // Hebrew, user-facing
  estimatedCostCents Int  @default(0)
  createdAt     DateTime  @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?

  outputs Asset[] @relation("JobOutputs")
  usage   UsageRecord[]

  @@index([projectId, createdAt])
  @@index([userId, createdAt])
  @@index([status])
}

model ProjectEvent {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // e.g. "project.created", "asset.uploaded", "job.succeeded"
  message   String   // Hebrew, shown in the history panel
  data      Json?
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

model UsageRecord {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String?
  job       Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  provider  String
  unit      String   // "characters" | "seconds" | "credits" ...
  quantity  Float
  costCents Int
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
