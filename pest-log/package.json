{
  "name": "yomen-hadbara",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "יומן ביצוע הדברה - מערכת ענן ליצחק אחזקות והדברות",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:rls": "vitest run --project rls",
    "test:all": "vitest run",
    "test:e2e": "npm run build:e2e && playwright test --grep-invert @screenshots",
    "pdf:service": "node --experimental-strip-types server/index.ts",
    "db:local": "node scripts/local-db.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "test:pdf": "vitest run --project pdf",
    "build:e2e": "vite build --mode e2e",
    "preview:e2e": "vite preview --mode e2e",
    "import:pest-catalog": "node scripts/import-catalog.mjs pests",
    "import:products": "node scripts/import-catalog.mjs products",
    "export": "node scripts/export.mjs",
    "screenshots": "npm run build:e2e && playwright test --grep @screenshots"
  },
  "dependencies": {
    "@fontsource/heebo": "^5.3.0",
    "@supabase/supabase-js": "^2.45.0",
    "idb": "^8.0.0",
    "lucide-react": "^1.47.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.11.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.9.0",
    "jose": "^5.9.0",
    "jsdom": "^25.0.0",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.12.0",
    "tsx": "^4.23.13",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.3.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  }
}
