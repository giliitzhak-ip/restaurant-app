# ─────────────────────────────────────────────────────────────────────────────
# יומן ביצוע הדברה — משתני סביבה (דוגמה)
# אין לשמור בקובץ הזה סודות אמיתיים. העתיקו ל-.env ומלאו מקומית.
# ─────────────────────────────────────────────────────────────────────────────

# ── צד לקוח (נחשף לדפדפן! רק מפתחות ציבוריים) ───────────────────────────────
# כתובת פרויקט ה-Supabase
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# מפתח anon הציבורי. הוא ציבורי בכוונה — ההגנה היא Row Level Security.
VITE_SUPABASE_ANON_KEY=REPLACE_WITH_ANON_KEY
# כתובת שירות הפקת ה-PDF (ראו server/)
VITE_PDF_SERVICE_URL=http://localhost:8787
# כתובת שאליה יחזור קישור ההתחברות (magic link)
VITE_AUTH_REDIRECT_URL=http://localhost:5173/auth/callback

# ── צד שרת בלבד (אסור שיגיע לדפדפן) ─────────────────────────────────────────
# מפתח service role. עוקף RLS. שמרו ב-secret manager, לא ב-git.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY
# הסוד לאימות חתימת ה-JWT שמגיע מהלקוח לשירות ה-PDF
SUPABASE_JWT_SECRET=REPLACE_WITH_JWT_SECRET
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# שירות ה-PDF
PDF_SERVICE_PORT=8787
# מאיזה origin מותר לקרוא לשירות ה-PDF (CORS), מופרד בפסיקים
PDF_SERVICE_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# כמה בקשות הפקת PDF מותרות לכל משתמש בחלון זמן (rate limiting)
PDF_SERVICE_RATE_LIMIT=10
PDF_SERVICE_RATE_WINDOW_MS=60000
# כמה זמן תקף signed URL של קובץ באחסון הפרטי (שניות)
SIGNED_URL_TTL_SECONDS=300
# כתובת בסיס להצגה/אימות עותק מאומת (נכנס ל-QR שב-PDF)
PUBLIC_VERIFY_BASE_URL=http://localhost:5173/verify

# ── בדיקות מקומיות מול Postgres (לא Supabase) ───────────────────────────────
# נוצר אוטומטית ע"י npm run db:local
TEST_DATABASE_URL=postgres://postgres@127.0.0.1:54329/postgres

# ── הפקת PDF ────────────────────────────────────────────────────────────────
# נתיב ל-Chromium מותקן. אם ריק — Playwright ישתמש בדפדפן שהוא הוריד בעצמו.
# בקונטיינר הבדיקות: /opt/pw-browsers/chromium
CHROMIUM_EXECUTABLE_PATH=
