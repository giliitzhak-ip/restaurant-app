# ─── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Required.
DATABASE_URL="postgresql://user:password@localhost:5432/shop?schema=public"

# ─── Authentication ────────────────────────────────────────────────────────────
# Signing key for admin session cookies. At least 32 random characters.
# Generate with: openssl rand -base64 48
AUTH_SECRET=""

# Seed credentials for the first admin user (used by `npm run db:seed` only).
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""

# ─── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Storage ───────────────────────────────────────────────────────────────────
# local | s3 | cloudinary
STORAGE_PROVIDER="local"
LOCAL_STORAGE_DIR="./storage/uploads"
MAX_UPLOAD_SIZE_MB="10"

# S3-compatible storage (required when STORAGE_PROVIDER=s3)
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# Cloudinary (required when STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── Integrations ──────────────────────────────────────────────────────────────
# All three ship as sandbox/console adapters. Replace with a real provider name
# once one is contracted, and add its implementation under src/lib/<domain>.
PAYMENT_PROVIDER="sandbox"
SHIPPING_PROVIDER="sandbox"
EMAIL_PROVIDER="console"

# ─── Simulator ─────────────────────────────────────────────────────────────────
# The operations simulator writes real (flagged) orders. It is always available
# outside production; set this to "true" to allow it on a production deployment.
ENABLE_SIMULATOR="false"
